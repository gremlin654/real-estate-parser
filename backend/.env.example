# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:secret@db/kufar_monitor
TEST_DATABASE_URL=postgresql+asyncpg://postgres:secret@db_test/kufar_monitor_test

# ============================================
# Scraper Settings
# ============================================
# Город для сканирования (mogilev, minsk, grodno, brest, gomel, vitebsk)
KUFAR_CITY=mogilev

# ============================================
# API Settings
# ============================================
API_PREFIX=/api/v1

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://redis:6379/0
REDIS_TEST_URL=redis://redis:6379/1

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO

# ============================================
# Telegram Bot Configuration
# ============================================
# Токен бота от @BotFather (обязательно для работы Telegram уведомлений)
TELEGRAM_BOT_TOKEN=

# Включить/выключить Telegram бота
TELEGRAM_BOT_ENABLED=false

# Максимальное количество попыток отправки сообщения (рекомендуется 3-5)
TELEGRAM_MAX_RETRIES=3

# Задержка перед первой попыткой в секундах (exponential backoff)
TELEGRAM_RETRY_DELAY_SECONDS=5

# Максимальное количество уведомлений в минуту (рекомендуется 20-30)
TELEGRAM_RATE_LIMIT_PER_MINUTE=20
